#!/bin/bash
# Stub for the `codex` CLI, used by run-cases.sh. The real codex binary is never
# invoked by the test suite; setup.sh reaches this file through SYNESIS_CODEX_BIN.
#
# bash 3.2 compatible. Behaviour is selected entirely by environment variables:
#
#   STUB_LOG                 file; every invocation appends its full argv on one line
#                            (assertions such as "plugin add was / was not called")
#
#   marketplace:
#   STUB_MP_HAS_GPTAKU=0|1   does `plugin marketplace list` report gptaku-codex?
#                            (default 1). Applies to both the --json and the table form.
#   STUB_MP_JSON_BROKEN=1    `plugin marketplace list --json` prints non-JSON so
#                            setup.sh must fall back to the human table, whose first
#                            line is the header `MARKETPLACE  ROOT`.
#   STUB_MP_ADD_RC=<n>       exit code of `plugin marketplace add <url>` (default 0)
#
#   plugin list:
#   STUB_PLUGIN_STATE=installed|empty|noversion|nonjson
#                            shape of `plugin list --json -m gptaku-codex` BEFORE any
#                            `plugin add` has flipped the state file (default installed)
#   STUB_PLUGIN_STATE_AFTER=...  same vocabulary, used once STUB_STATE_FILE exists
#                            (default installed)
#   STUB_STATE_FILE          file used to persist the flip performed by `plugin add`
#   STUB_SRC_PATH            value reported as source.path (may be the empty string,
#                            which forces setup.sh onto its cache fallback)
#   STUB_VERSION             version reported for the installed plugin (default 0.16.3)
#
#   plugin add:
#   STUB_ADD_MODE=ok|noop|sleep|fail
#                            ok    = create STUB_STATE_FILE so the next list reports
#                                    STUB_PLUGIN_STATE_AFTER, exit 0
#                            noop  = exit 0 without touching the state file
#                            sleep = hang for 300s (exercises the watchdog)
#                            fail  = exit 1
set -u

STUB_LOG="${STUB_LOG:-}"
if [ -n "$STUB_LOG" ]; then
  printf '%s\n' "$*" >> "$STUB_LOG"
fi

STUB_MP_HAS_GPTAKU="${STUB_MP_HAS_GPTAKU:-1}"
STUB_MP_JSON_BROKEN="${STUB_MP_JSON_BROKEN:-0}"
STUB_MP_ADD_RC="${STUB_MP_ADD_RC:-0}"
STUB_PLUGIN_STATE="${STUB_PLUGIN_STATE:-installed}"
STUB_PLUGIN_STATE_AFTER="${STUB_PLUGIN_STATE_AFTER:-installed}"
STUB_STATE_FILE="${STUB_STATE_FILE:-}"
STUB_SRC_PATH="${STUB_SRC_PATH:-}"
STUB_VERSION="${STUB_VERSION:-0.16.3}"
STUB_ADD_MODE="${STUB_ADD_MODE:-ok}"

emit_plugin_list() {
  state="$STUB_PLUGIN_STATE"
  if [ -n "$STUB_STATE_FILE" ] && [ -f "$STUB_STATE_FILE" ]; then
    state="$STUB_PLUGIN_STATE_AFTER"
  fi
  case "$state" in
    installed)
      printf '{"installed":[{"pluginId":"insane-search-codex@gptaku-codex","installed":true,"enabled":true,"version":"%s","source":{"path":"%s"}}],"available":[]}\n' \
        "$STUB_VERSION" "$STUB_SRC_PATH" ;;
    noversion)
      printf '{"installed":[{"pluginId":"insane-search-codex@gptaku-codex","installed":true,"enabled":true,"source":{"path":"%s"}}],"available":[]}\n' \
        "$STUB_SRC_PATH" ;;
    empty)
      printf '{"installed":[],"available":[]}\n' ;;
    nonjson)
      printf 'error: could not render plugin list <<not json>>\n' ;;
    *)
      printf 'stub codex: unknown STUB_PLUGIN_STATE=%s\n' "$state" >&2
      exit 64 ;;
  esac
}

cmd="$*"
case "$cmd" in
  "plugin marketplace list --json")
    if [ "$STUB_MP_JSON_BROKEN" = 1 ]; then
      printf 'error: --json is not supported by this build\n'
      exit 0
    fi
    if [ "$STUB_MP_HAS_GPTAKU" = 1 ]; then
      printf '{"marketplaces":[{"name":"gptaku-codex","root":"/stub/root/gptaku-codex"}]}\n'
    else
      printf '{"marketplaces":[{"name":"some-other-marketplace","root":"/stub/root/other"}]}\n'
    fi
    ;;
  "plugin marketplace list")
    printf 'MARKETPLACE  ROOT\n'
    if [ "$STUB_MP_HAS_GPTAKU" = 1 ]; then
      printf 'gptaku-codex  /stub/root/gptaku-codex\n'
    else
      printf 'some-other-marketplace  /stub/root/other\n'
    fi
    ;;
  "plugin marketplace add"*)
    if [ "$STUB_MP_ADD_RC" = 0 ]; then
      printf 'stub codex: marketplace added\n'
    else
      printf 'stub codex: marketplace add failed (simulated)\n' >&2
    fi
    exit "$STUB_MP_ADD_RC"
    ;;
  "plugin list --json -m gptaku-codex")
    emit_plugin_list
    ;;
  "plugin add"*)
    case "$STUB_ADD_MODE" in
      ok)
        if [ -n "$STUB_STATE_FILE" ]; then printf 'added\n' > "$STUB_STATE_FILE"; fi
        printf 'stub codex: plugin added\n'
        exit 0 ;;
      noop)
        printf 'stub codex: plugin add reported success but changed nothing\n'
        exit 0 ;;
      sleep)
        exec sleep 300 ;;
      fail)
        printf 'stub codex: plugin add failed (simulated)\n' >&2
        exit 1 ;;
      *)
        printf 'stub codex: unknown STUB_ADD_MODE=%s\n' "$STUB_ADD_MODE" >&2
        exit 64 ;;
    esac
    ;;
  *)
    printf 'stub codex: unhandled invocation: %s\n' "$cmd" >&2
    exit 127
    ;;
esac
exit 0
